# Copy to .env and fill in. Never commit .env.
# With no MAIN_API_KEY the app runs in mock mode using data/fixture-cards.json.

# Answers the user sees: Muse Spark via Meta Model API (check the Model list page for the exact ID)
MAIN_BASE_URL=https://api.meta.ai/v1
MAIN_API_KEY=
MAIN_MODEL=muse-spark-1.3

# Background memory work: Muse Spark Open via Baseten. Leave BG_API_KEY empty to use MAIN for everything.
BG_BASE_URL=https://inference.baseten.co/v1
BG_API_KEY=
BG_MODEL=meta-models/muse-spark-open-1026

# Grader: a second model checks each new card before it's saved. Defaults to Muse Wonder.
# GRADER=off keeps only the code rules.
GRADER=on
GRADER_MODEL=muse-wonder-1.0
# GRADER_BASE_URL=
# GRADER_API_KEY=

PORT=3000
USER_NAME=Vamshi
# Fix "today" for a repeatable demo (2026-11-17 is a Tuesday, a veg day in the test data)
DEMO_TODAY=2026-11-17
# Hours between quick checks. Use 0 while recording the demo.
CUE_COOLDOWN_HOURS=24
RATE_LIMIT_PER_MINUTE=30

# Agent name and avatar shown in the header. For a personal local avatar, put the
# image at public/avatar-local.png (git ignores it) and set AGENT_AVATAR=avatar-local.png.
# Keep the submitted version on original art; don't commit third-party characters.
AGENT_NAME=Pip
AGENT_AVATAR=

# Hard daily spend cap for model calls (USD). Calls stop once reached.
SPEND_CAP_USD=3
# Token prices used for the cap (check your Billing page)
PRICE_IN_PER_M=1.25
PRICE_OUT_PER_M=4.25
